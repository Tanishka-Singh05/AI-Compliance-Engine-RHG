# ACE Service
ACE_PORT=8000
ACE_METRICS_PORT=9090
ACE_METRICS_ENABLED=true

# OPA Policy Engine
OPA_URL=http://localhost:8181

# LLM Backend
GROQ_API_KEY=

# Agentic release-hardening loop (Phase 11/12)
# LLMProvider resolves this; only "nebius" is registered today.
MODEL_PROVIDER=nebius
# NVIDIA Nemotron via Nebius Token Factory. The key is only read at request
# time, so leaving it empty does not stop the service from booting - agentic
# runs then fail closed (BLOCK) instead of shipping unreviewed patches.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1
NEMOTRON_MODEL=nvidia/nemotron-3-super-120b-a12b
# Escalate to a human below this remediation confidence.
AGENT_CONFIDENCE_THRESHOLD=0.85
# Retries per finding, on top of the first attempt.
AGENT_MAX_RETRIES=3

# Redis
REDIS_URL=redis://localhost:6379

# Database (PostgreSQL 16)
DATABASE_URL=postgresql://ace:password@localhost:5432/ace

# Alerting
SLACK_WEBHOOK_URL=
SQS_ALERT_QUEUE_URL=

# Gate Policy
RHG_PORT=8001
ACE_URL=http://localhost:8000
MAX_MUTATION_RETRIES=3
BLOCK_ON_SEVERITY=HIGH
DASHBOARD_URL=http://localhost:3000

# Mutation OPS notifications (v2)
SLACK_WEBHOOK_URL=
NOTIFY_ON_SEVERITY=CRITICAL,HIGH     # only notify for these severities (CRITICAL|HIGH|MEDIUM|LOW|ALL)

# Email mutation notifications (v2)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
OPS_EMAIL_LIST=ops@yourorg.com,platform@yourorg.com

# Compatibility agent (v2)
ACE_COMPAT_AGENT=true

# AWS (Lambda deployment)
AWS_REGION=ap-south-1
ECR_URI=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=